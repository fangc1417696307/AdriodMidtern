<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    tools:context=".BookDetailActivity">

    <!-- 顶部栏：返回 + 页面标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/book_blue"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/detail_title"
            android:textColor="@color/book_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- 书名 -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/book_blue"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="三体" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/divider" />

            <!-- 作者 -->
            <TextView
                style="@style/BookDetailLabel"
                android:text="@string/label_author" />

            <TextView
                android:id="@+id/tvDetailAuthor"
                style="@style/BookDetailValue"
                tools:text="刘慈欣" />

            <!-- 出版社 -->
            <TextView
                style="@style/BookDetailLabel"
                android:text="@string/label_publisher" />

            <TextView
                android:id="@+id/tvDetailPublisher"
                style="@style/BookDetailValue"
                tools:text="重庆出版社" />

            <!-- 出版年份 -->
            <TextView
                style="@style/BookDetailLabel"
                android:text="@string/label_year" />

            <TextView
                android:id="@+id/tvDetailYear"
                style="@style/BookDetailValue"
                tools:text="2008 年" />

            <!-- 价格 -->
            <TextView
                style="@style/BookDetailLabel"
                android:text="@string/label_price" />

            <TextView
                android:id="@+id/tvDetailPrice"
                style="@style/BookDetailValue"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="￥23.00" />

            <!-- 内容简介 -->
            <TextView
                style="@style/BookDetailLabel"
                android:text="@string/label_summary" />

            <TextView
                android:id="@+id/tvDetailSummary"
                style="@style/BookDetailValue"
                tools:text="文化大革命如火如荼进行的同时，军方探寻外星文明的绝秘计划……" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
