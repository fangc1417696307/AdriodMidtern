<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 学号尾号 4、5 —— 所有文字统一使用蓝色 @color/book_blue -->

    <!-- 列表项：书名 -->
    <style name="BookItemTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/book_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 列表项：作者 · 出版社 -->
    <style name="BookItemAuthor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/book_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 列表项：价格 -->
    <style name="BookItemPrice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/book_blue</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <!-- 列表项：圆底序号 -->
    <style name="BookItemIndex">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_index</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/book_blue</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>

    <!-- 详情页：字段名 -->
    <style name="BookDetailLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/book_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">18dp</item>
    </style>

    <!-- 详情页：字段值 -->
    <style name="BookDetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/book_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

</resources>
